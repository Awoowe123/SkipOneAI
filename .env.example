# Telegram API Configuration
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890

# Bot Owner (for style mimicry)
BOT_OWNER_ID=your_telegram_id_here

# LLM Configuration (LM Studio)
OLLAMA_BASE_URL=http://localhost:1234
OLLAMA_MODEL=glm-4-9b-chat

# Database
DB_PATH=data/personality.db
SESSION_PATH=data/session

# Behavior Settings
SKIP_MESSAGE_PROBABILITY=0.0
IMMEDIATE_RESPONSE_PROBABILITY=0.99
TYPING_SPEED_WPM=60

# Proactive Messaging (bot initiates conversation)
PROACTIVE_MESSAGING_ENABLED=false
PROACTIVE_CHECK_INTERVAL_HOURS=6
PROACTIVE_MIN_SILENCE_HOURS=12
PROACTIVE_PROBABILITY=0.3
